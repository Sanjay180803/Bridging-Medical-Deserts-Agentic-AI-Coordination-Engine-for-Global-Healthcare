# Copy to .env and fill in. Only the key for LLM_PROVIDER is required.
LLM_PROVIDER=openai          # openai | google | groq | anthropic
LLM_MODEL=gpt-4o
OPENAI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=

EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# Optional external verification
ENABLE_EXTERNAL_VERIFICATION=false
SERP_API_KEY=
TAVILY_API_KEY=

# Data paths default to ./data; override if needed
# HOSPITALS_CSV=
# DB_PATH=
